# AWS credentials are NOT stored here. Configure them with `aws configure` or your usual AWS setup.
AWS_REGION=us-east-1

ECON_AGENT_CHAT_MODEL=anthropic.claude-opus-5-5
# Client-side refusal fallback model. Leave empty to disable.
ECON_AGENT_FALLBACK_MODEL=anthropic.claude-opus-5
ECON_AGENT_JUDGE_MODEL=anthropic.claude-opus-5-5
ECON_AGENT_EFFORT=medium

ECON_AGENT_EMBEDDING_MODEL=amazon.titan-embed-text-v2:0
ECON_AGENT_EMBEDDING_DIM=1024
# Set to 1 to use the local hashing embedder instead of Titan (no AWS, lower quality).
ECON_AGENT_OFFLINE_EMBEDDINGS=0

ECON_AGENT_DATA_DIR=data
ECON_AGENT_FIRST_MEETING=266
ECON_AGENT_INDICATORS_START=2015-01
ECON_AGENT_MAX_ITERATIONS=8
